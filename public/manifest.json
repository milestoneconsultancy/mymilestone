{
  "name": "Milestone ERP",
  "short_name": "Milestone",
  "description": "Enterprise recruitment, interview tracking, and offer letter automation",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "background_color": "#0A2E5A",
  "theme_color": "#0A2E5A",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/api/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", "image/*"]
        }
      ]
    }
  }
}
